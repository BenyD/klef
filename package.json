{
  "name": "klef-cli",
  "private": true,
  "description": "The Klef CLI and @klefsh/core: end-to-end encrypted .env sync, built so a coding agent can run it without seeing a value.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "cli": "node src/cli/index.ts",
    "build:cli": "vite build --config vite.cli.config.ts --logLevel warn && node scripts/build-cli.ts",
    "build:core": "node scripts/build-core.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenyD/klef.git"
  },
  "homepage": "https://klef.sh"
}
