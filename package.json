{
  "name": "klef",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Personal, zero-knowledge, end-to-end-encrypted .env sync. Self-hostable on Cloudflare.",
  "bin": {
    "klef": "src/cli/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "cli": "node src/cli/index.ts",
    "build:cli": "vite build --config vite.cli.config.ts --logLevel warn && node scripts/build-cli.ts",
    "build:core": "node scripts/build-core.ts",
    "build": "tsc --noEmit && vite build && pnpm run prerender && pnpm run build:docs",
    "build:docs": "cd docs-site && react-router build && node scripts/publish.ts",
    "docs:dev": "cd docs-site && react-router dev",
    "prerender": "vite build --config vite.prerender.config.ts --logLevel warn && node dist/prerender/prerender.js",
    "preview": "vite preview",
    "og": "node scripts/og.ts",
    "icons": "node scripts/icons.ts",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && cd docs-site && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "auth generate --config ./scripts/auth-cli.ts --output ./db/migrations/0001_better_auth.sql -y",
    "db:migrate:local": "wrangler d1 migrations apply klef-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply klef-db --remote",
    "cf-typegen": "wrangler types"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/passkey": "^1.7.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.11",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^8.5.0",
    "shadcn": "^4.19.0",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7",
    "isbot": "^5.2.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-router/dev": "^8.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "auth": "1.7.14",
    "better-sqlite3": "^12.11.1",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.17.8",
    "happy-dom": "^21.0.4",
    "satori": "^0.33.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  }
}
