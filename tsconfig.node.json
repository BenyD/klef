// The CLI, the build scripts and every test, which run on Node. DOM for the
// Web Crypto types the core's tests use.
{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.cli.config.ts",
    "vitest.config.ts",
    "scripts",
    "src/cli",
    "src/shared/**/*.test.ts"
  ]
}
