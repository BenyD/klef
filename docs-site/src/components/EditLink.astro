---
// Starlight's "Edit page" link, plus the same page as plain Markdown (the
// export agents read; see pages/[...slug].md.ts).
import Default from "@astrojs/starlight/components/EditLink.astro";

const id = Astro.locals.starlightRoute.id;
const md = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${id === "" ? "index" : id}.md`;
---

<div class="klef-page-links">
	<Default />
	<a href={md} class="klef-md-link">View as Markdown</a>
</div>
