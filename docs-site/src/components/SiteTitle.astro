---
// The Klef tile and wordmark, then "Docs", linking to the docs home. The
// tile matches the favicon: the woven asterisk (src/web/components/KlefMark.tsx)
// in the tile's foreground, its weave gaps cut with masks.
const href = import.meta.env.BASE_URL;
---

<a href={href} class="site-title klef-site-title">
	<span class="klef-mark" aria-hidden="true">
		<svg viewBox="0 0 100 100" fill="none">
			<defs>
				<mask id="klef-docs-m0" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
					<rect width="100" height="100" fill="white"></rect>
					<rect x="38" y="12" width="24" height="76" rx="12" stroke="black" stroke-width="18" transform="rotate(60 50 50)"></rect>
					<rect x="38" y="12" width="24" height="76" rx="12" stroke="black" stroke-width="18" transform="rotate(120 50 50)"></rect>
				</mask>
				<mask id="klef-docs-m1" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
					<rect width="100" height="100" fill="white"></rect>
					<rect x="38" y="12" width="24" height="76" rx="12" stroke="black" stroke-width="18" transform="rotate(120 50 50)"></rect>
				</mask>
			</defs>
			<g stroke="currentColor" stroke-width="9">
				<g mask="url(#klef-docs-m0)"><rect x="38" y="12" width="24" height="76" rx="12"></rect></g>
				<g mask="url(#klef-docs-m1)"><rect x="38" y="12" width="24" height="76" rx="12" transform="rotate(60 50 50)"></rect></g>
				<rect x="38" y="12" width="24" height="76" rx="12" transform="rotate(120 50 50)"></rect>
			</g>
		</svg>
	</span>
	<span class="klef-wordmark">klef</span>
	<span class="klef-docs-label">Docs</span>
</a>
